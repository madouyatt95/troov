generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum DocType {
  CNI
  PASSPORT
}

enum UserRole {
  OWNER
  AGENT
  MODERATOR
  ADMIN
  SUPER_ADMIN
}

enum DeclarationStatus {
  PENDING
  APPROVED
  DEPOSITED
  MATCHED
  PICKED_UP
  CLOSED
  REJECTED
  EXPIRED
}

enum ReportStatus {
  SEARCHING
  MATCHED
  RECOVERED
  CANCELLED
}

enum MatchStatus {
  PENDING
  CONFIRMED
  REJECTED
  EXPIRED
}

model User {
  id            String    @id @default(uuid())
  phoneHash     String    @map("phone_hash")
  phoneSalt     String    @map("phone_salt")
  role          UserRole  @default(OWNER)
  trustScore    Int       @default(50) @map("trust_score")
  isBlocked     Boolean   @default(false) @map("is_blocked")
  blockedReason String?   @map("blocked_reason")
  language      String    @default("fr")
  createdAt     DateTime  @default(now()) @map("created_at")
  lastLogin     DateTime? @map("last_login")

  ownerReports OwnerReport[]
  agent        Agent?
  auditLogs    AuditLog[]

  @@map("users")
}

model Declaration {
  id                    String            @id @default(uuid())
  docType               DocType           @map("doc_type")
  partialNumberHash     String            @map("partial_number_hash")
  namePrefixHash        String            @map("name_prefix_hash")
  salt                  String
  regionFound           String            @map("region_found")
  depositPointId        String?           @map("deposit_point_id")
  status                DeclarationStatus @default(PENDING)
  deviceFingerprintHash String?           @map("device_fingerprint_hash")
  trackingCode          String            @unique @map("tracking_code")
  ipAddress             String?           @map("ip_address")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")
  expiresAt             DateTime?         @map("expires_at")

  depositPoint DepositPoint? @relation(fields: [depositPointId], references: [id])
  matches      Match[]

  @@index([partialNumberHash, namePrefixHash])
  @@index([trackingCode])
  @@index([status])
  @@map("declarations")
}

model OwnerReport {
  id                String       @id @default(uuid())
  userId            String       @map("user_id")
  docType           DocType      @map("doc_type")
  fullNumberHash    String       @map("full_number_hash")
  fullNameHash      String       @map("full_name_hash")
  dobHash           String       @map("dob_hash")
  partialNumberHash String       @map("partial_number_hash")
  namePrefixHash    String       @map("name_prefix_hash")
  salt              String
  status            ReportStatus @default(SEARCHING)
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  matches Match[]

  @@index([partialNumberHash, namePrefixHash])
  @@index([userId])
  @@map("owner_reports")
}

model Match {
  id              String      @id @default(uuid())
  declarationId   String      @map("declaration_id")
  reportId        String      @map("report_id")
  confidenceScore Float       @default(1.0) @map("confidence_score")
  status          MatchStatus @default(PENDING)
  matchedAt       DateTime    @default(now()) @map("matched_at")
  resolvedAt      DateTime?   @map("resolved_at")

  declaration Declaration @relation(fields: [declarationId], references: [id], onDelete: Cascade)
  report      OwnerReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([declarationId, reportId])
  @@map("matches")
}

model DepositPoint {
  id        String   @id @default(uuid())
  name      String
  type      String   @default("ADMIN") // 'ADMIN' | 'OPERATOR_SHOP'
  address   String
  latitude  Float
  longitude Float
  region    String
  department String?
  operator  String? // 'ORANGE' | 'FREE' | 'EXPRESSO'
  phone     String?
  hours     String? // e.g. "8h-18h Lun-Ven"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  declarations Declaration[]
  agents       Agent[]

  @@index([region, isActive])
}

model Agent {
  id               String   @id @default(uuid())
  userId           String   @unique @map("user_id")
  depositPointId   String   @map("deposit_point_id")
  status           String   @default("ACTIVE")
  completedPickups Int      @default(0) @map("completed_pickups")
  createdAt        DateTime @default(now()) @map("created_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  depositPoint DepositPoint @relation(fields: [depositPointId], references: [id])

  @@map("agents")
}

model AuditLog {
  id                String   @id @default(uuid())
  event             String
  userId            String?  @map("user_id")
  ipAddress         String   @map("ip_address")
  deviceFingerprint String?  @map("device_fingerprint")
  targetType        String?  @map("target_type")
  targetId          String?  @map("target_id")
  metadata          Json?
  previousHash      String   @map("previous_hash")
  hash              String
  createdAt         DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([event, createdAt])
  @@index([userId])
  @@map("audit_logs")
}

model OtpToken {
  id        String   @id @default(uuid())
  phoneHash String   @map("phone_hash")
  otpHash   String   @map("otp_hash")
  attempts  Int      @default(0)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([phoneHash, expiresAt])
  @@map("otp_tokens")
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("push_subscriptions")
}
