# Database
DATABASE_URL="postgresql://user:password@localhost:5432/troov?schema=public"

# Security - GENERATE THESE WITH: openssl rand -hex 32
HASH_PEPPER="CHANGE_ME_32_BYTE_RANDOM_SECRET"
HMAC_SECRET="CHANGE_ME_ANOTHER_32_BYTE_SECRET"
JWT_SECRET="CHANGE_ME_JWT_SIGNING_SECRET"

# Redis (Upstash) - Optional for development
# UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="xxx"

# WhatsApp Business Cloud API (Primary OTP channel)
# Get these from Meta Business Suite: https://business.facebook.com/
WHATSAPP_PHONE_NUMBER_ID="your_phone_number_id"
WHATSAPP_ACCESS_TOKEN="your_access_token"

# SMS Gateway - Fallback (Choose one)
# Twilio
# TWILIO_ACCOUNT_SID="ACxxx"
# TWILIO_AUTH_TOKEN="xxx"
# TWILIO_PHONE_NUMBER="+1234567890"

# Or AfricasTalking
# AT_API_KEY="xxx"
# AT_USERNAME="xxx"
# AT_SENDER_ID="TROOV"

# hCaptcha
# HCAPTCHA_SITE_KEY="xxx"
# HCAPTCHA_SECRET_KEY="xxx"

# Web Push (Generate with: npx web-push generate-vapid-keys)
# NEXT_PUBLIC_VAPID_PUBLIC_KEY="xxx"
# VAPID_PRIVATE_KEY="xxx"

# App Config
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Feature Flags
ENABLE_OPERATOR_LOOKUP="false"
ENABLE_SHOP_DEPOSIT="false"
